<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>unilidar_driver</name>
  <version>1.0.0</version>
  <description>
    Unitree L1 激光雷达驱动：自行实现 UDP 报文解析，发布标准 PointCloud2 与
    Imu 话题，不链接官方静态库。协议字段与几何公式依据官方 BSD-3-Clause 开源
    头文件重述。解析核心不依赖 ROS，可离线自检。
  </description>
  <maintainer email="qi-neo@users.noreply.github.com">qi-neo</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>
  <depend>tf2</depend>
  <depend>tf2_ros</depend>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
