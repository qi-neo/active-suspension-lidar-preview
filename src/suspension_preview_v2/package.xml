<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>suspension_preview_v2</name>
  <version>2.0.0</version>
  <description>
    ROS2 节点（v2）：订阅 UniLiDAR 点云，鲁棒提取左右轮迹路面高程剖面，
    经 CRC16 校验的 int16 压缩串口协议下发给主动悬架控制器，并发布 ROS2 话题与 rviz 可视化。
    相比 v1：修正 QoS/串口 raw 模式/TF fail-safe、中位数鲁棒估计、有效掩码、参数化、独立发送线程。
  </description>
  <maintainer email="qi-neo@users.noreply.github.com">qi-neo</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>rosidl_default_generators</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>visualization_msgs</depend>
  <depend>pcl_conversions</depend>
  <depend>tf2_ros</depend>
  <depend>tf2</depend>
  <depend>libpcl-all-dev</depend>

  <exec_depend>rosidl_default_runtime</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <member_of_group>rosidl_interface_packages</member_of_group>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
